<view class="container index-page">
  <!-- 自定义导航栏：解决背景顶到红框区域的问题 -->
  <view class="custom-nav" style="height: {{statusBarHeight + navBarHeight}}px;">
    <view class="nav-title" style="margin-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
      <image class="nav-title-img" src="../../images/title-index.png" mode="heightFix" />
    </view>
  </view>

  <!-- 顶部：滚动公告栏（点击查看完整说明） -->
  <view class="notice-bar" bindtap="showDisclaimer">
    <text class="notice-icon-emoji">📢</text>
    <view class="notice-content">
      <view class="notice-text">
        去水印小程序作为中立的技术服务提供者，旨在协助用户个人学习与素材赏析。我们郑重提醒用户，务必合法使用，任何因滥用而导致的侵权行为，责任将由用户自行承担。本程序不存储任何数字影像，资料版权归原平台及作者所有。去水印小程序致力于与用户携手，共同维护一个健康、积极的网络环境。此声明适用于本服务的所有功能。
      </view>
    </view>
  </view>

  <view class="top-section">
    <!-- 输入区：增加了“厚度感”样式 -->
    <view class="input-wrap">
      <textarea
        placeholder="请复制分享的短视频链接到此处"
        bindinput="onInput"
        value="{{inputValue}}"
        class="input-box"
        disabled="{{isLoading}}"
      />
    </view>

    <!-- 操作区域：粘贴/清空 + 喵去水印 -->
    <view class="btn-row">
      <button 
        class="action-secondary-btn {{inputValue ? 'btn-clear' : 'btn-paste'}}" 
        bindtap="{{inputValue ? 'clearInput' : 'doPaste'}}"
        disabled="{{isLoading}}"
      >
        <text>{{inputValue ? '清空内容' : '粘贴内容'}}</text>
      </button>
      
      <button
        class="main-btn {{isLoading ? 'loading' : ''}}"
        bindtap="onSubmit"
        disabled="{{isButtonDisabled}}"
      >
        <view wx:if="{{!isLoading}}" class="btn-content">
          <text>喵去水印（免费）</text>
        </view>
        <view wx:else class="loading-inner">
          <text class="loading-dot">·</text><text class="loading-dot">·</text><text class="loading-dot">·</text>
        </view>
      </button>
    </view>
  </view>

  <!-- 结果区：卡片式封装 -->
  <view class="result-section" wx:if="{{showWhiteBackground}}">
    <view class="result-card">
      <view class="author-panel">
        <image class="author-avatar" src="{{response.author.avatar || '../../images/default-avatar.png'}}" mode="aspectFill" />
        <view class="author-meta">
          <text class="author-name">{{response.author.nickname || '未知作者'}}</text>
          <text class="author-subtitle">{{response.platform || '解析素材'}} · 创作者</text>
        </view>
        <view class="platform-badge">{{mediaTypeLabel}}</view>
      </view>

      <view class="result-divider"></view>

      <view class="media-header" wx:if="{{mediaCount}}">
        <text class="media-title">{{mediaTypeLabel}}</text>
        <text class="media-count">{{mediaCount}}个文件</text>
      </view>

      <view class="video-block" wx:if="{{showVideo}}">
        <view class="video-glass-label">{{response.platform || '视频素材'}}</view>
        <video
          class="result-video"
          src="{{response.video_url}}"
          poster="{{response.cover_url}}"
          binderror="onVideoError"
          controls
        />
      </view>

      <scroll-view class="image-strip" scroll-x wx:if="{{showImageList}}">
        <view class="image-strip-inner">
          <view
            class="image-thumb-wrap"
            wx:for="{{response.image_list}}"
            wx:key="*this"
            data-url="{{item}}"
            bindtap="previewImageList"
          >
            <image class="image-thumb" src="{{item}}" mode="aspectFill" />
            <view class="image-index">{{index + 1}}</view>
          </view>
        </view>
      </scroll-view>

      <view class="cover-preview" wx:if="{{showCoverButton && !showVideo && !showImageList}}" bindtap="viewCoverImage">
        <image class="cover-image" src="{{response.cover_url}}" mode="aspectFill" />
        <text class="cover-tip">点击查看封面</text>
      </view>

      <scroll-view class="image-strip live-strip" scroll-x wx:if="{{showLivePhotos}}">
        <view class="image-strip-inner">
          <view
            class="image-thumb-wrap live-thumb-wrap"
            wx:for="{{response.live_photo_list}}"
            wx:key="*this"
            data-url="{{item}}"
            bindtap="previewLivePhotos"
          >
            <image class="image-thumb" src="{{item}}" mode="aspectFill" />
            <view class="live-badge">LIVE</view>
          </view>
        </view>
      </scroll-view>

      <view class="audio-card" wx:if="{{showAudio}}">
        <view class="record-icon {{audioPlaying ? 'record-playing' : ''}}" bindtap="toggleAudio">
          <view class="record-dot"></view>
        </view>
        <view class="audio-info" bindtap="toggleAudio">
          <text class="audio-title">原声音乐</text>
          <text class="audio-desc">{{audioLoading ? '正在加载音频...' : (audioPlaying ? '正在播放，点击暂停' : '点击试听')}}</text>
        </view>
        <button class="audio-copy-btn" bindtap="toggleAudio">{{audioLoading ? '加载中' : (audioPlaying ? '暂停' : '试听')}}</button>
      </view>

      <view class="title-block" wx:if="{{showArticle}}">
        <text class="title-label">文案内容</text>
        <text class="title-content" selectable>{{response.title}}</text>
      </view>

      <view class="action-matrix">
        <view class="action-row">
          <button class="action-btn btn-save" bindtap="downloadVideo" wx:if="{{showSaveVideoButton}}">
            <image class="action-btn-icon" src="../../images/download_vid.png" />
            <text>保存视频</text>
          </button>
          <button class="action-btn btn-cover" bindtap="downloadCover" wx:if="{{showSaveCoverButton}}">
            <image class="action-btn-icon" src="../../images/download_img.png" />
            <text>保存封面</text>
          </button>
          <button class="action-btn btn-primary" bindtap="downloadImageList" wx:if="{{showSaveImagesButton}}">
            <image class="action-btn-icon" src="../../images/download_img.png" />
            <text>保存图集</text>
          </button>
          <button class="action-btn btn-share" open-type="share">
            <image class="action-btn-icon" src="../../images/share-icon.png" />
            <text>分享好友</text>
          </button>
        </view>
      </view>

      <!-- 底部链接复制 -->
      <view class="copy-links">
        <text class="copy-link" bindtap="copyTitle">复制标题</text>
        <text class="copy-sep">|</text>
        <text class="copy-link" bindtap="copyCoverUrl">复制封面</text>
        <text class="copy-sep">|</text>
        <text class="copy-link" wx:if="{{showImageList}}" bindtap="copyImageList">复制图集</text>
        <text class="copy-link" wx:else bindtap="copyVideoUrl">复制视频</text>
        <text class="copy-sep">|</text>
        <text class="copy-link" bindtap="copyAllInfo">复制全部</text>
      </view>
    </view>
  </view>
  
  <!-- 底部卡片：使用指南 -->
  <view class="footer-card" bindtap="navigateToQuestions">
    <view class="footer-card-left">
      <text class="footer-card-title">使用指南 & 常见问题</text>
      <text class="footer-card-desc">解决解析失败、保存失败等问题</text>
    </view>
    <view class="footer-card-right">
      <image src="../../images/cat.png" class="footer-cat-peek" mode="aspectFit" />
    </view>
  </view>
</view>
