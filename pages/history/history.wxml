<view class="history-page">
  <view class="history-summary">
    <text class="summary-title">解析历史</text>
    <text class="summary-desc">共 {{total}} 条记录，点击卡片查看解析结果</text>
  </view>

  <view class="history-list" wx:if="{{items.length}}">
    <view class="history-card" wx:for="{{items}}" wx:key="id" bindtap="viewRecord" data-id="{{item.id}}">
      <image class="history-cover" src="{{item.cover_url || '../../images/default-avatar.png'}}" mode="aspectFill" />
      <view class="history-content">
        <text class="history-title">{{item.title || item.normalized_url}}</text>
        <text class="history-meta">{{item.platform || '未知平台'}} · {{item.author_name || '未知作者'}}</text>
        <view class="history-bottom">
          <text class="status status-{{item.status}}">{{item.status_text}}</text>
          <text class="history-time">{{item.display_time}}</text>
        </view>
        <text class="history-error" wx:if="{{item.error_message}}">{{item.error_message}}</text>
      </view>
      <view class="history-actions">
        <button class="history-action retry-action" catchtap="retryRecord" data-id="{{item.id}}">重试</button>
        <button class="history-action delete-action" catchtap="deleteRecord" data-id="{{item.id}}">删除</button>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-title">{{loading ? '正在加载...' : '暂无解析记录'}}</text>
    <text class="empty-desc" wx:if="{{!loading}}">完成一次解析后，记录会展示在这里</text>
  </view>

  <view class="load-tip" wx:if="{{items.length}}">
    {{loading ? '正在加载...' : (hasMore ? '上拉加载更多' : '没有更多记录了')}}
  </view>
</view>
