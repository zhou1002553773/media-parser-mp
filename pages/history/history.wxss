page {
  background: #f7f8fa;
}

.history-page {
  padding: 20px 20px 40px;
}

.history-summary {
  padding: 18px 16px;
  margin-bottom: 18px;
  border-radius: 18px;
  background: #fff;
  border: 1px solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 10px 28px rgba(28, 34, 44, 0.08);
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.summary-title {
  font-size: 20px;
  font-weight: 700;
  color: #17181c;
}

.summary-desc {
  font-size: 12px;
  color: #8d939d;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.history-card {
  padding: 12px;
  border-radius: 16px;
  background: #fff;
  display: flex;
  gap: 12px;
  box-shadow: 0 4px 16px rgba(23, 30, 45, 0.06);
}

.history-cover {
  width: 78px;
  height: 96px;
  border-radius: 11px;
  background: #eef1f4;
  flex-shrink: 0;
}

.history-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.history-title {
  font-size: 14px;
  line-height: 19px;
  font-weight: 700;
  color: #22252b;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.history-meta,
.history-time {
  font-size: 11px;
  color: #9399a4;
}

.history-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  gap: 8px;
}

.status {
  padding: 2px 7px;
  border-radius: 999px;
  font-size: 10px;
  background: #eef1f4;
  color: #697180;
}

.status-success {
  background: #e9f8ef;
  color: #27844b;
}

.status-failed {
  background: #fff0f0;
  color: #d5484d;
}

.history-error {
  font-size: 10px;
  color: #d5484d;
}

.history-actions {
  width: 48px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8px;
}

.history-action {
  width: 48px;
  height: 28px;
  line-height: 28px;
  padding: 0;
  margin: 0;
  border-radius: 8px;
  font-size: 11px;
}

.history-action::after {
  border: none;
}

.retry-action {
  background: #f0f2f5;
  color: #596273;
}

.delete-action {
  background: #fff0f0;
  color: #d5484d;
}

.empty-state {
  padding: 90px 20px;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 8px;
}

.empty-title {
  font-size: 16px;
  font-weight: 600;
  color: #4c5360;
}

.empty-desc,
.load-tip {
  font-size: 12px;
  color: #9aa0aa;
}

.load-tip {
  padding: 22px 0 4px;
  text-align: center;
}
